samplePlane
{
    type            surfaces;
    libs            (sampling);
    executeControl  timeStep;
    executeInterval 1;
    writeControl    timeStep;
    writeInterval   1;
    fields          ( U );
    surfaceFormat   raw;
    store           true;
    interpolationScheme cell;
    surfaces
    {
        plane_yplus_15
        {
            type            plane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point   (0 0.08333 0);
                normal  (0 1 0);

            }
            triangulate	    false;
            interpolate     false;
            enabled         true;
        }

        wall
        {
            type            patch;
            patches         (wall);
        }        
    }   
}

