probes1
{
    type	        patchProbes;
    libs	        (sampling);
    writeControl    timeStep;
    writeInterval   1;
    fixedLocations	true;
    patch           wall;
    fields          ( Uy );
    probeLocations
    (
        (0.1 0 0.1)
        (0.2 0 0.2)
        (0.3 0 0.3)
        (0.4 0 0.4)
        (0.5 0 0.5)
        (0.6 0 0.6)
        (0.7 0 0.7)
        (0.8 0 0.8)
        (0.9 0 0.9)
    );
}


