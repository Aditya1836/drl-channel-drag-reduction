wallShearStress
{
    type                wallShearStress;
    libs                (fieldFunctionObjects);
    log                 yes;
    patches             ( wall );
    writePrecision      10;
    writeFields         yes;
    writeToFile         yes;
    executeControl      timeStep;
    executeInterval     1;
    writeControl        writeTime;
    timeStart           $/timeStart;
}

